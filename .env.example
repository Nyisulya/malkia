# =========================================================================
# MALKIA CARGO WAVE LIMITED - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env on your VPS and fill in your real credentials.
# =========================================================================

# Django Core
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=False
CSRF_TRUSTED_ORIGINS=https://malkiacargowave.com,https://portal.malkiacargowave.com

# Hive AI Assistant
HIVE_API_KEY=
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash

# Resend Email Engine (Primary)
RESEND_API_KEY=
RESEND_SENDER_NAME="Malkia Cargo Wave Limited"
RESEND_FROM_EMAIL=info@malkiacargowave.com

# SMS Gate Android Gateway (sms-gate.app)
SMS_GATE_SERVER_URL=https://api.sms-gate.app
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
SMS_GATE_DEVICE_ID=
SMS_GATE_SIM_NUMBER=1
SMS_GATE_ORDER_PHONE=

# NextSMS Tanzania (Optional Fallback)
NEXTSMS_API_KEY=
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=
NEXTSMS_SENDER_ID=MALKIA
NEXTSMS_API_URL=https://messaging-service.co.tz/api/sms/v1/text/single

# Cloudflare R2 Object Storage
CLOUDFLARE_R2_ENABLED=true
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# Search Engine Verification (Optional - Can also be configured in Admin UI)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
