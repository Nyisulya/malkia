# =========================================================================
# MALKIA CARGO WAVE LIMITED - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env on your VPS / aaPanel server:
# cp .env.example .env
# =========================================================================

# Django Core Security
DJANGO_SECRET_KEY=replace-with-a-random-secure-secret-key-in-production
DJANGO_DEBUG=False
PORT=3444

# Hive AI Assistant (Executive Chatbot & Public Inquiries)
HIVE_API_KEY=your_hive_api_key_here
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash

# Email Delivery (Resend API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_SENDER_NAME="Malkia Cargo Wave Limited"
RESEND_FROM_EMAIL=info@malkiacargowave.com

# SMTP Email Delivery (Gmail Fallback)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USE_TLS=True
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
DEFAULT_TEST_EMAIL=info@malkiacargowave.com

# Cloudflare R2 Storage (Optional - Object Storage for documents)
CLOUDFLARE_R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
