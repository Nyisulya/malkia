[Unit]
Description=Malkia Cargo Wave Portal (Gunicorn Daemon on Port 3444)
After=network.target

[Service]
User=root
Group=www-data
WorkingDirectory=/var/www/malkia
Environment="PATH=/var/www/malkia/.venv/bin"
Environment="DJANGO_SETTINGS_MODULE=malkia_project.settings"
ExecStart=/var/www/malkia/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:3444 \
    --timeout 120 \
    --access-logfile /var/log/malkia_access.log \
    --error-logfile /var/log/malkia_error.log \
    malkia_project.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

